# Copy to .env and adjust per environment.

# --- Where the app calls the API -------------------------------------------
# Relative ("/api/v1") routes through the Vite dev proxy — use this locally.
# Absolute ("https://host/api/v1") calls the API directly and requires the API
# host to allow this site's origin via CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Only used by vite.config.ts for the dev/preview proxy. Leave unset to disable
# proxying (then VITE_API_BASE_URL must be absolute).
#   Production:  https://clubconnect-plapt.ondigitalocean.app
#   Local Laravel: http://localhost:8000
#   ngrok tunnel:  https://<subdomain>.ngrok-free.app
VITE_API_PROXY_TARGET=https://clubconnect-plapt.ondigitalocean.app

# Toggle the authenticated web app (Sign in / Join + /app routes).
VITE_ENABLE_APP=true

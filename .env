# Afrisport Connect — marketing site + web app
#
# The API is the same one the Flutter app talks to by default
# (mobile/lib/core/netwo rk/api_client.dart -> ApiClient.baseUrl).

# --- Development / preview -------------------------------------------------
# Relative base: requests go to this site's own origin and Vite proxies them
# to VITE_API_PROXY_TARGET below. This sidesteps the API host's missing CORS
# headers without touching the backend.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=https://clubconnect-plapt.ondigitalocean.app

# For a production build the proxy does not exist — see .env.production.

# Set to "false" to hide the Sign in / Join buttons and block /login, /signup
# and /app entirely — useful when demoing the marketing site on its own.
VITE_ENABLE_APP=true

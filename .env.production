# Used by `npm run build`. A static production build has no Vite dev proxy,
# so the browser calls the API host directly and real CORS applies.
#
# REQUIRED on the API host before this works in production — set the env var
# (config only, no code change) and redeploy:
#
#   CORS_ALLOWED_ORIGINS=https://your-marketing-domain.com
#
# Verify with:
#   curl -I -H "Origin: https://your-marketing-domain.com" \
#     https://clubconnect-plapt.ondigitalocean.app/api/v1/settings
#   -> must return an Access-Control-Allow-Origin header.
#
# Alternative if you would rather not touch the API host: serve this build
# behind a reverse proxy (Nginx/Cloudflare/Vercel rewrite) that forwards
# /api to the Laravel host, and set VITE_API_BASE_URL=/api/v1 instead.

VITE_API_BASE_URL=https://clubconnect-plapt.ondigitalocean.app/api/v1
VITE_ENABLE_APP=true
